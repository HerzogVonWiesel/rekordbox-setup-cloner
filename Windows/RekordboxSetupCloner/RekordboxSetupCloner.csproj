<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <PublishAot>true</PublishAot>
    <IlcOptimizationPreference>Size</IlcOptimizationPreference>
    <JsonSerializerIsReflectionEnabledByDefault>false</JsonSerializerIsReflectionEnabledByDefault>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AssemblyName>RekordboxSetupCloner</AssemblyName>
    <Product>Rekordbox Setup Cloner</Product>
    <Description>Portable rekordbox preferences and local restore points</Description>
    <Version>0.2.1</Version>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../RekordboxSetupCloner.Core/RekordboxSetupCloner.Core.csproj" />
  </ItemGroup>
</Project>
